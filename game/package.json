{
  "name": "atomic-adventures-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Playable Atomic Adventures — Part I vertical slice and full game.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch-path=server server/index.js",
    "build": "node server/export-runtime-content.js && vite build && node server/verify-production-build.js",
    "content:runtime": "node server/export-runtime-content.js",
    "preview": "NODE_ENV=production node server/index.js",
    "content:import": "node server/content-cli.js import",
    "content:export": "node server/content-cli.js export",
    "world:import": "node server/world-cli.js import",
    "world:export": "node server/world-cli.js export",
    "building:import": "node server/building-cli.js import",
    "building:export": "node server/building-cli.js export",
    "character:import": "node server/character-cli.js import",
    "character:export": "node server/character-cli.js export",
    "learning:import": "node server/learning-cli.js import",
    "learning:export": "node server/learning-cli.js export",
    "test": "vitest run",
    "sync:energy-sim": "node scripts/sync-energy-sim.mjs",
    "browser:smoke": "node scripts/browser-smoke.mjs",
    "playtest:alpha-smoke": "node scripts/alpha-play-smoke.mjs",
    "test:movement": "MOVEMENT_AUDIT_REPORT=1 vitest run src/lib/maps/testing/mapMovementAudit.test.js --reporter=verbose",
    "test:watch": "vitest"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "katex": "^0.17.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vue": "^3.5.35",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "^5.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "vite": "^8.0.14",
    "vitest": "^4.1.9"
  }
}
